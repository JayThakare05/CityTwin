# Server settings
PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Supabase server credentials. Never use SUPABASE_SERVICE_ROLE_KEY in the React app.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenWeather credentials and the city centre used for live AQI and rainfall.
OPENWEATHER_API_KEY=your-openweather-api-key
CITY_LATITUDE=19.195
CITY_LONGITUDE=72.975

# Groq credentials. The supported Groq model ID for GPT-OSS 120B is shown below.
GROQ_API_KEY=your-groq-api-key
GROQ_REPORT_VERIFICATION_MODEL=openai/gpt-oss-120b

# TomTom Traffic Flow tiles. Keep the real key only in backend/.env.
TOMTOM_API_KEY=your-tomtom-api-key
